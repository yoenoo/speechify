{
  "name": "speechify-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A website that reads a PDF aloud, highlighting each sentence and the word being spoken",
  "scripts": {
    "start": "npm run build:web && node web/serve.mjs",
    "build:web": "node web/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:web": "node web/build.mjs && xvfb-run -a electron --no-sandbox test/e2e/web-smoke.js",
    "fixtures": "node test/fixtures/make-pdf.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "electron": "^44.4.3"
  }
}
